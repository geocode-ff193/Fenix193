rules_version = '2';

// ============================================================
//  FUNDAÇÃO FÊNIX 193 — Firestore Security Rules  v1.7.0
//  Setembro 2026
//
//  Coleções protegidas:
//    admins            → acesso restrito ao próprio UID
//    contacts          → criação pública com validação; gestão Grau 1/4
//    transparency_docs → leitura pública; escrita Grau 1/3
//    news              → leitura pública; escrita Grau 1/2
//    eventos           → leitura pública; escrita Grau 1/5 (Atuação)
//    projetos          → leitura pública; escrita Grau 1/5 (Atuação)
//    capacitacao       → leitura pública; escrita Grau 1/5 (Atuação)
//    timeline          → leitura pública; escrita somente Grau 1
//    apoiadores        → leitura pública; escrita somente Grau 1
//
//  Grau de Administração (NOVO):
//    Cada admin pode ter um ou mais graus, em admins/{uid}.graus
//    (array de números). Grau 1 dá acesso a tudo.
//      1 = Acesso a Tudo        4 = Contatos
//      2 = Notícias             5 = Atuação (Projetos/Capacitação/Eventos)
//      3 = Transparência
//    Linha do Tempo e Apoiadores exigem Grau 1 (fora do esquema 2–5).
//    Sem o campo "graus" (contas antigas), assume-se [1] — acesso total.
//
//  Como adicionar um admin:
//    Firebase Console → Firestore → coleção "admins"
//    Crie um documento cujo ID seja o UID do usuário (Auth → Users)
//    Campos mínimos: { email: "admin@fenix.org", name: "Nome",
//                       graus: [2, 3] }
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ──────────────────────────────────────────────────────────
    //  FUNÇÕES AUXILIARES GLOBAIS
    // ──────────────────────────────────────────────────────────

    /** Usuário autenticado? */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Usuário é admin?
     * Lê apenas o documento do próprio UID — permitido pelas regras
     * de admins abaixo. NÃO usa getDocs() na coleção inteira,
     * evitando varredura não autorizada.
     */
    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    /**
     * Grau de Administração (1 a 5), definido manualmente em
     * admins/{uid}.graus (array de números). Um admin pode ter
     * vários graus. Grau 1 = acesso a tudo.
     *   2 = Notícias · 3 = Transparência · 4 = Contatos · 5 = Atuação
     * Linha do Tempo e Apoiadores exigem Grau 1 (não listados
     * individualmente no esquema pedido).
     * Sem o campo "graus" (contas antigas), assume-se [1] — total.
     */
    function myGraus() {
      let d = get(/databases/$(database)/documents/admins/$(request.auth.uid)).data;
      return ('graus' in d) ? d.graus : [1];
    }

    function hasGrau(g) {
      return isAdmin() && myGraus().hasAny([1, g]);
    }

    /** Grau 1 apenas — usado por Linha do Tempo e Apoiadores */
    function isFullAdmin() {
      return isAdmin() && myGraus().hasAny([1]);
    }

    /** Campo obrigatório é string não-vazia? */
    function requiredString(field) {
      return field is string && field.size() > 0;
    }

    // ──────────────────────────────────────────────────────────
    //  VALIDADORES POR COLEÇÃO
    // ──────────────────────────────────────────────────────────

    /** Contato enviado pelo formulário público */
    function isValidContact() {
      let d = request.resource.data;
      return d.keys().hasAll(['nome', 'email', 'mensagem', 'createdAt'])
          && d.nome    is string                        // pode ser vazio (anônimo)
          && requiredString(d.email)
          && d.email.matches('.*@.*\\..*')
          && requiredString(d.mensagem)
          && d.mensagem.size() <= 4000
          && d.read    is bool;
    }

    /** Documento publicado no portal de transparência */
    function isValidTransparencyDoc() {
      let d = request.resource.data;
      let cats = [
        'Prestação de Contas', 'Relatórios Institucionais',
        'Estatuto Social', 'Certidões', 'Contratos', 'Editais', 'Atas'
      ];
      return d.keys().hasAll(['nome', 'link', 'categoria', 'createdAt'])
          && requiredString(d.nome)   && d.nome.size()      <= 200
          && requiredString(d.link)   && d.link.size()      <= 500
          && d.categoria in cats;
    }

    /** Notícia publicada pelo painel */
    function isValidNews() {
      let d = request.resource.data;
      return d.keys().hasAll(['titulo', 'autor', 'corpo', 'createdAt'])
          && requiredString(d.titulo) && d.titulo.size() <= 300
          && requiredString(d.autor)  && d.autor.size()  <= 100
          && requiredString(d.corpo)  && d.corpo.size()  <= 50000;
    }

    /** Evento publicado pelo painel */
    function isValidEvento() {
      let d = request.resource.data;
      let custos = ['Gratuito', 'Pago'];
      // data deve ser YYYY-MM-DD (10 chars), horario HH:MM (5 chars)
      return d.keys().hasAll(['titulo', 'data', 'horario', 'local', 'custo', 'descricao', 'createdAt'])
          && requiredString(d.titulo)   && d.titulo.size()   <= 300
          && requiredString(d.data)     && d.data.size()     == 10
          && requiredString(d.horario)  && d.horario.size()  == 5
          && requiredString(d.local)    && d.local.size()    <= 300
          && d.custo in custos
          && requiredString(d.descricao) && d.descricao.size() <= 10000;
    }

    /** Projeto publicado pelo painel (Atuação > Projetos) */
    function isValidProjeto() {
      let d = request.resource.data;
      let statuses = ['planning', 'active', 'deactive', 'course'];
      return d.keys().hasAll(['titulo', 'status', 'icone', 'area', 'publico', 'objetivo', 'descricao', 'createdAt'])
          && requiredString(d.titulo)    && d.titulo.size()    <= 300
          && d.status in statuses
          && requiredString(d.icone)     && d.icone.size()     <= 100
          && requiredString(d.area)      && d.area.size()      <= 200
          && requiredString(d.publico)   && d.publico.size()   <= 200
          && requiredString(d.objetivo)  && d.objetivo.size()  <= 2000
          && requiredString(d.descricao) && d.descricao.size() <= 10000;
    }

    /** Curso publicado pelo painel (Atuação > Capacitação) */
    function isValidCapacitacao() {
      let d = request.resource.data;
      let cores = ['red', 'fire', 'navy', 'green'];
      return d.keys().hasAll(['titulo', 'descricao', 'cargaHoraria', 'nivel', 'icone', 'cor', 'modulos', 'createdAt'])
          && requiredString(d.titulo)       && d.titulo.size()       <= 300
          && requiredString(d.descricao)    && d.descricao.size()    <= 5000
          && requiredString(d.cargaHoraria) && d.cargaHoraria.size() <= 50
          && requiredString(d.nivel)        && d.nivel.size()        <= 50
          && requiredString(d.icone)        && d.icone.size()        <= 100
          && d.cor in cores
          && d.modulos is list && d.modulos.size() > 0;
    }

    /** Marco da linha do tempo publicado pelo painel (Edição > Linha do Tempo) */
    function isValidTimeline() {
      let d = request.resource.data;
      return d.keys().hasAll(['ano', 'tag', 'titulo', 'descricao', 'createdAt'])
          && requiredString(d.ano)       && d.ano.size()       <= 20
          && requiredString(d.tag)       && d.tag.size()       <= 60
          && requiredString(d.titulo)    && d.titulo.size()    <= 200
          && requiredString(d.descricao) && d.descricao.size() <= 3000;
    }

    /** Apoiador/parceiro publicado pelo painel (Edição > Apoiadores) */
    function isValidApoiador() {
      let d = request.resource.data;
      return d.keys().hasAll(['nome', 'foto', 'createdAt'])
          && requiredString(d.nome) && d.nome.size() <= 200
          && requiredString(d.foto) && d.foto.size() <= 500
          && (!('link' in d.keys()) || d.link == null || (d.link is string && d.link.size() <= 500));
    }

    // ──────────────────────────────────────────────────────────
    //  ADMINS
    //  Leitura: somente o próprio usuário pode ler seu documento.
    //  Escrita: bloqueada (somente via Firebase Console).
    // ──────────────────────────────────────────────────────────
    match /admins/{uid} {
      allow read:   if isSignedIn() && request.auth.uid == uid;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // ──────────────────────────────────────────────────────────
    //  CONTACTS
    //  Criação: pública (formulário de contato do site),
    //           sujeita à validação de campos.
    //  Leitura / atualização / exclusão: admins com Grau 1 ou 4.
    // ──────────────────────────────────────────────────────────
    match /contacts/{docId} {
      allow create: if isValidContact();
      allow read:   if hasGrau(4);
      allow update: if hasGrau(4);
      allow delete: if hasGrau(4);
    }

    // ──────────────────────────────────────────────────────────
    //  TRANSPARENCY_DOCS
    //  Leitura: pública (portal de transparência).
    //  Criação / atualização / exclusão: admins com Grau 1 ou 3,
    //           sujeita à validação de campos.
    // ──────────────────────────────────────────────────────────
    match /transparency_docs/{docId} {
      allow read:   if true;
      allow create: if hasGrau(3) && isValidTransparencyDoc();
      allow update: if hasGrau(3) && isValidTransparencyDoc();
      allow delete: if hasGrau(3);
    }

    // ──────────────────────────────────────────────────────────
    //  NEWS
    //  Leitura: pública (blog de notícias).
    //  Criação / atualização / exclusão: admins com Grau 1 ou 2,
    //           sujeita à validação de campos.
    // ──────────────────────────────────────────────────────────
    match /news/{docId} {
      allow read:   if true;
      allow create: if hasGrau(2) && isValidNews();
      allow update: if hasGrau(2) && isValidNews();
      allow delete: if hasGrau(2);
    }

    // ──────────────────────────────────────────────────────────
    //  EVENTOS
    //  Leitura: pública (página de eventos do site).
    //  Criação / atualização / exclusão: admins com Grau 1 ou 5
    //           (Atuação), sujeita à validação de campos.
    // ──────────────────────────────────────────────────────────
    match /eventos/{docId} {
      allow read:   if true;
      allow create: if hasGrau(5) && isValidEvento();
      allow update: if hasGrau(5) && isValidEvento();
      allow delete: if hasGrau(5);
    }

    // ──────────────────────────────────────────────────────────
    //  PROJETOS
    //  Leitura: pública (página de projetos do site).
    //  Criação / atualização / exclusão: admins com Grau 1 ou 5
    //           (Atuação), sujeita à validação de campos.
    // ──────────────────────────────────────────────────────────
    match /projetos/{docId} {
      allow read:   if true;
      allow create: if hasGrau(5) && isValidProjeto();
      allow update: if hasGrau(5) && isValidProjeto();
      allow delete: if hasGrau(5);
    }

    // ──────────────────────────────────────────────────────────
    //  CAPACITAÇÃO
    //  Leitura: pública (página de capacitação do site).
    //  Criação / atualização / exclusão: admins com Grau 1 ou 5
    //           (Atuação), sujeita à validação de campos.
    // ──────────────────────────────────────────────────────────
    match /capacitacao/{docId} {
      allow read:   if true;
      allow create: if hasGrau(5) && isValidCapacitacao();
      allow update: if hasGrau(5) && isValidCapacitacao();
      allow delete: if hasGrau(5);
    }

    // ──────────────────────────────────────────────────────────
    //  LINHA DO TEMPO
    //  Leitura: pública (página Nossa História).
    //  Criação / atualização / exclusão: somente admins Grau 1
    //           (não faz parte do esquema de graus 2–5),
    //           sujeita à validação de campos.
    // ──────────────────────────────────────────────────────────
    match /timeline/{docId} {
      allow read:   if true;
      allow create: if isFullAdmin() && isValidTimeline();
      allow update: if isFullAdmin() && isValidTimeline();
      allow delete: if isFullAdmin();
    }

    // ──────────────────────────────────────────────────────────
    //  APOIADORES
    //  Leitura: pública (página Parcerias).
    //  Criação / atualização / exclusão: somente admins Grau 1
    //           (não faz parte do esquema de graus 2–5),
    //           sujeita à validação de campos.
    // ──────────────────────────────────────────────────────────
    match /apoiadores/{docId} {
      allow read:   if true;
      allow create: if isFullAdmin() && isValidApoiador();
      allow update: if isFullAdmin() && isValidApoiador();
      allow delete: if isFullAdmin();
    }

  }
}